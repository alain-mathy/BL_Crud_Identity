
<div class="top-row ps-3 navbar navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="home">BL_Crud_Identity</a>
    </div>
</div>

<div class="nav-scrollable">
    <nav class="flex-column">
        <AuthorizeView>
            <Authorized>
                @* Renders the navigation link ONLY if the user is logged in *@
                <div class="nav-item px-3">
                    @if (context.User.IsInRole("Admin"))
                    {
                        <NavLink class="nav-link text-white" href="usersList" Match="NavLinkMatch.All">
                            <span class="bi bi-people-fill" aria-hidden="true"></span> <span>Users Management</span>
                        </NavLink>
                    }
                    else
                    {
                        var currentUserId = context.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
                        <NavLink class="nav-link text-white" href="@($"users/edit/{currentUserId}")" Match="NavLinkMatch.All">
                            <span class="bi bi-person-lines-fill" aria-hidden="true"></span> <span>My Profile</span>
                        </NavLink>
                    }
                </div>
            </Authorized>
            <NotAuthorized>
                @* Renders completely empty when the user is anonymous *@
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

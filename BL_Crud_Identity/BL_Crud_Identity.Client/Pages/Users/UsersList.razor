@page "/usersList"
@rendermode InteractiveAuto

<PageTitle>User Management</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people-fill"></i> User Management Dashboard</h2>
        <button class="btn btn-outline-secondary btn-sm" @onclick="LoadUsersAsync" disabled="@_isLoading">
            <span class="bi bi-arrow-clockwise"></span> Refresh
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @_errorMessage
        </div>
    }

    @if (_isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading users...</span>
            </div>
        </div>
    }
    else if (!_users.Any())
    {
        <div class="alert alert-info text-center" role="alert">
            No registered users found in the system.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover table-striped align-middle mb-0 bg-white">
                <thead class="table-dark">
                    <tr>
                        <th>Full Name</th>
                        <th>Email Address</th>
                        <th>Location</th>
                        <th class="text-center" style="width: 180px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in _users)
                    {
                        <tr>
                            <td>
                                <strong>@user.FullName</strong>
                            </td>
                            <td>@user.Email</td>
                            <td>
                                <small class="text-muted">@user.FullAddress</small>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <button class="btn btn-primary" @onclick="() => NavigateToEdit(user.Id)">
                                        <i class="bi bi-pencil"></i> Edit
                                    </button>
                                    <button class="btn btn-danger" @onclick="() => HandleDeleteUserAsync(user.Id)" disabled="@_isDeleting">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private IEnumerable<UserDto> _users = Enumerable.Empty<UserDto>();
    private bool _isLoading = true;
    private bool _isDeleting;
    private string _errorMessage = string.Empty;

    /// <summary>
    /// Lifecycle method invoked when the component is initialized.
    /// Triggers the initial asynchronous loading of users.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    /// <summary>
    /// Fetches all registered users from the service layer.
    /// </summary>
    private async Task LoadUsersAsync()
    {
        _isLoading = true;
        _errorMessage = string.Empty;

        try
        {
            _users = await ClientUserService.GetAllUsersAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load users: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// Redirects the client navigation to the user modification view.
    /// </summary>
    /// <param name="userId">The unique identifier of the user to edit.</param>
    private void NavigateToEdit(string userId)
    {
        Navigation.NavigateTo($"/users/edit/{userId}");
    }

    /// <summary>
    /// Confirms via browser prompt and handles user deletion workflow.
    /// </summary>
    /// <param name="userId">The unique identifier of the user to remove.</param>
    private async Task HandleDeleteUserAsync(string userId)
    {
        // Find the user object locally to display their name in the prompt message
        var targetUser = _users.FirstOrDefault(u => u.Id == userId);
        var userName = targetUser != null ? targetUser.FullName : "this user";

        // Prompt a native browser confirmation dialog box
        var isConfirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to permanently delete {userName}?");

        if (!isConfirmed)
        {
            return; // Abort deletion process if the user clicks 'Cancel'
        }

        _isDeleting = true;
        _errorMessage = string.Empty;

        try
        {
            var success = await ClientUserService.DeleteUserAsync(userId);
            if (success)
            {
                // Refresh the local collection by removing the user item locally
                _users = _users.Where(u => u.Id != userId).ToList();
            }
            else
            {
                _errorMessage = "The server rejected the deletion request. Ensure you have proper administrative privileges.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred during user deletion: {ex.Message}";
        }
        finally
        {
            _isDeleting = false;
        }
    }
}

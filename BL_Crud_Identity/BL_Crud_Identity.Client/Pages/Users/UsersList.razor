@page "/usersList"
@rendermode InteractiveAuto

<PageTitle>System Access</PageTitle>

<AuthorizeView>
    <Authorized>
        @* --- CASE 1: USER IS AN ADMINISTRATOR --- *@
        @if (context.User.IsInRole("Admin"))
        {
            <div class="container mt-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2><i class="bi bi-people-fill"></i> User Management Dashboard</h2>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="LoadUsersAsync" disabled="@_isLoading">
                        <span class="bi bi-arrow-clockwise"></span> Refresh
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger" role="alert">@_errorMessage</div>
                }

                @if (_isLoading)
                {
                    <div class="d-flex justify-content-center my-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading users...</span>
                        </div>
                    </div>
                }
                else if (!_users.Any())
                {
                    <div class="alert alert-info text-center" role="alert">
                        No registered users found in the system.
                    </div>
                }
                else
                {
                    <div class="table-responsive shadow-sm rounded">
                        <table class="table table-hover table-striped align-middle mb-0 bg-white">
                            <thead class="table-dark">
                                <tr>
                                    <th>Full Name</th>
                                    <th>Email Address</th>
                                    <th>Location</th>
                                    <th>Role</th>
                                    <th class="text-center" style="width: 180px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in _users)
                                {
                                    <tr>
                                        <td><strong>@user.FullName</strong></td>
                                        <td>@user.Email</td>
                                        <td><small class="text-muted">@user.FullAddress</small></td>
                                        <td>
                                            <span class="badge @(user.Role == "Admin" ? "bg-danger" : "bg-primary")">
                                                @user.Role
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm" role="group">
                                                <button class="btn btn-primary" @onclick="() => NavigateToEdit(user.Id)">
                                                    <i class="bi bi-pencil"></i> Edit
                                                </button>
                                                <button class="btn btn-danger" @onclick="() => HandleDeleteUserAsync(user.Id)" disabled="@_isDeleting">
                                                    <i class="bi bi-trash"></i> Delete
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
        else
        {
            @* --- CASE 2: USER IS A REGULAR USER (NOT ADMIN) --- *@
            var currentUserId = context.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
            @if (!string.IsNullOrEmpty(currentUserId))
            {
                <div class="container mt-2">
                    <EditUser Id="@currentUserId" />
                </div>
            }
        }
    </Authorized>
    <NotAuthorized>
        @* --- CASE 3: ANONYMOUS USER --- *@
        <div class="container mt-5 text-center">
            <div class="alert alert-warning" role="alert">
                <h4>Access Denied</h4>
                <p>You must be authenticated to view this section. Please log in from the home dashboard.</p>
                <a href="home" class="btn btn-primary mt-2">Go to Home</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private IEnumerable<UserDto> _users = Enumerable.Empty<UserDto>();
    private bool _isLoading = true;
    private bool _isDeleting;
    private string _errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        _isLoading = true;
        _errorMessage = string.Empty;

        try
        {
            _users = await ClientUserService.GetAllUsersAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load users: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void NavigateToEdit(string userId)
    {
        Navigation.NavigateTo($"/users/edit/{userId}");
    }

    private async Task HandleDeleteUserAsync(string userId)
    {
        var targetUser = _users.FirstOrDefault(u => u.Id == userId);
        var userName = targetUser != null ? targetUser.FullName : "this user";

        var isConfirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to permanently delete {userName}?");
        if (!isConfirmed) return;

        _isDeleting = true;
        _errorMessage = string.Empty;

        try
        {
            var success = await ClientUserService.DeleteUserAsync(userId);
            if (success)
            {
                _users = _users.Where(u => u.Id != userId).ToList();
            }
            else
            {
                _errorMessage = "The server rejected the deletion request. Ensure you have proper administrative privileges.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred during user deletion: {ex.Message}";
        }
        finally
        {
            _isDeleting = false;
        }
    }
}
